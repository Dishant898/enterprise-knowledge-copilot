# Local development only. These credentials are intentionally simple and must not be used in production.
# Host-run backend and migration commands use the canonical localhost URL.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/knowledge-copilot

# Dockerized backend connects to the same host PostgreSQL using Docker Desktop's host gateway.
DOCKER_DATABASE_URL=postgresql+psycopg://username:password@host.docker.internal:5432/knowledge-copilot

REDIS_PASSWORD=local-dev-redis-password
REDIS_URL=redis://:local-dev-redis-password@localhost:6379/0

LLM_API_KEY=
