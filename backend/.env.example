POSTGRES_DB=enterprise_knowledge_copilot
POSTGRES_USER=enterprise_knowledge_user
POSTGRES_PASSWORD=local-dev-password-only
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/knowledge-copilot

REDIS_PASSWORD=local-dev-redis-password
REDIS_URL=redis://:local-dev-redis-password@localhost:6379/0

LLM_API_KEY=

ENVIRONMENT=local
DEVELOPMENT_AUTH_ENABLED=true
DEVELOPMENT_AUTH_SUBJECT=dev|admin
DEVELOPMENT_AUTH_USERNAME=admin
DEVELOPMENT_AUTH_PASSWORD=admin
AUTH_COOKIE_SECURE=false
